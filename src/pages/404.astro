---
import siteConfig from "@/data/site-config";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Page Not Found"
  description={siteConfig.description}
  image={siteConfig.image}
  showBreadcrumbs={false}
  noindex
>
  <section class="pt-[clamp(3rem,9vh,6rem)]">
    <p class="mono-label text-gold-text">Folio Missing</p>
    <h1 class="poster-name mt-5">404<span class="text-gold">.</span></h1>
    <p
      class="text-muted-foreground mt-8 max-w-[52ch] text-base leading-relaxed sm:text-lg"
    >
      The page you are looking for does not exist. It may have moved, or the
      address may be mistyped.
    </p>
    <div class="mt-10 flex flex-wrap gap-x-8 gap-y-3">
      <a
        href="/"
        class="mono-label text-gold-text transition-colors hover:text-foreground"
      >
        &larr; Back to the journal
      </a>
      <a
        href="/blog/"
        class="mono-label text-muted-foreground transition-colors hover:text-foreground"
      >
        All writing <span class="text-gold-text">&rarr;</span>
      </a>
    </div>
  </section>
</BaseLayout>
