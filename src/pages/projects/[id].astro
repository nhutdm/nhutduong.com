---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Prose from "@/components/Prose.astro";
import TOC from "@/components/TOC.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { id: project.id },
    props: { project },
  }));
}

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { title, kicker, stack, repo, seo } = project.data;
const { Content, headings } = await render(project);
---

<BaseLayout
  title={seo?.title ?? title}
  description={seo?.description ?? project.data.tagline}
>
  <article>
    <header>
      <p class="mono-label text-gold-text">{kicker}</p>
      <h1
        class="font-serif text-[clamp(2.25rem,5vw,3.5rem)] leading-[1.15] font-bold tracking-tight text-balance sm:leading-[1.08] mt-4"
      >
        {title}<span class="text-gold">.</span>
      </h1>
      <p class="mono-label text-muted-foreground mt-5">{stack}</p>
      <div class="rule-gold mt-8" aria-hidden="true"></div>
    </header>
    <div class="mt-10 lg:flex lg:items-start lg:gap-12">
      <TOC headings={headings} class="order-2 mb-8 lg:mb-0" />
      <article class="max-w-[36rem]">
        <Prose>
          <Content />
        </Prose>
      </article>
    </div>
    <footer
      class="mt-16 border-t border-border pt-8 flex flex-wrap items-baseline gap-x-8 gap-y-3"
    >
      <a
        href={repo}
        class="mono-label text-muted-foreground transition-colors hover:text-foreground"
      >
        Source on GitHub ↗
      </a>
      <a
        href="/projects/"
        class="mono-label text-muted-foreground transition-colors hover:text-foreground"
      >
        &larr; All projects
      </a>
    </footer>
  </article>
</BaseLayout>
