---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/BaseHead.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Footer from "@/components/Footer.astro";
import JsonLd from "@/components/JsonLd.astro";
import Masthead from "@/components/Masthead.astro";
import siteConfig from "@/data/site-config";
import type { BaseHeadProps, Thing, WithContext } from "@/types";
import {
  generateBreadcrumbItems,
  generateBreadcrumbStructuredData,
  shouldShowBreadcrumbs,
} from "@/utils/breadcrumb-utils";
import { createWebPageSchema, createWebSiteSchema } from "@/utils/schema-utils";

export type Props = BaseHeadProps & {
  showBreadcrumbs?: boolean;
  masthead?: "page" | "poster";
  lastModified?: Date;
  customSchemas?: WithContext<Thing>[];
};

const {
  showBreadcrumbs = true,
  masthead = "page",
  lastModified,
  customSchemas = [],
  ...head
} = Astro.props;

const siteUrl = Astro.site?.toString() ?? "https://nhutduong.com";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();

const shouldShow = showBreadcrumbs && shouldShowBreadcrumbs(Astro.url.pathname);
const breadcrumbItems = shouldShow
  ? await generateBreadcrumbItems(Astro.url.pathname)
  : [];
const breadcrumbStructuredData = shouldShow
  ? generateBreadcrumbStructuredData(
      breadcrumbItems,
      Astro.url.pathname,
      siteUrl,
    )
  : null;

const schemas: WithContext<Thing>[] = [
  createWebSiteSchema(siteUrl),
  createWebPageSchema(
    canonicalUrl,
    head.title || siteConfig.title,
    head.description || siteConfig.description,
    lastModified,
  ),
];

if (customSchemas.length > 0) {
  schemas.push(...customSchemas);
}
---

<!doctype html>
<html lang="en" class="wrap-break-word antialiased">
  <head>
    <BaseHead {...head} />
    <Font cssVariable="--font-dm-sans" preload />
    <Font cssVariable="--font-source-serif" preload />
    <Font cssVariable="--font-ibm-plex-mono" />
    <JsonLd schema={schemas} />
    {breadcrumbStructuredData && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(breadcrumbStructuredData).replace(
          /</g,
          "\\u003c",
        )}
      />
    )}
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="bg-primary text-primary-foreground sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 rounded-md px-4 py-2 text-sm font-medium"
    >
      Skip to content
    </a>
    <div class="flex min-h-dvh flex-col">
      <Masthead variant={masthead} />
      <main
        id="main"
        class="mx-auto w-full max-w-7xl grow px-6 py-12 sm:py-16 lg:py-20"
      >
        {shouldShow && (
          <div class="mb-10">
            <Breadcrumbs items={breadcrumbItems} />
          </div>
        )}
        <slot />
      </main>
      <Footer />
    </div>
    <script>
    const assignAnimationOrder = () => {
      for (const group of document.querySelectorAll("[data-animate-group]")) {
        group
          .querySelectorAll<HTMLElement>(":scope > [data-animate]")
          .forEach((element, index) => {
            element.style.setProperty("--i", String(index));
          });
      }
    };

    document.addEventListener("astro:page-load", assignAnimationOrder);
    </script>
  </body>
</html>
