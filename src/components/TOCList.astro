---
import TOCHeading from "@/components/TOCHeading.astro";
import type { TocItem } from "@/types";

interface Props {
  headings: TocItem[];
  class?: string;
}

const { headings, class: className } = Astro.props;
---

<toc-heading class={className}>
  <ul class="grid gap-3.5 pl-4 font-mono text-xs tracking-wide">
    {headings.map((heading) => <TOCHeading heading={heading} />)}
  </ul>
</toc-heading>
