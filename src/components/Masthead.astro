---
import Logo from "@/components/Logo.astro";
import NavLink from "@/components/NavLink.astro";
import siteConfig from "@/data/site-config";

const { variant = "page" } = Astro.props;
const navLinks = siteConfig.primaryNavLinks || [];
---

<header class="w-full border-b">
  <div
    class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-5"
  >
    {variant === "poster" ? (
      <p class="mono-label text-muted-foreground">
        Est. 2012<span class="hidden sm:inline"> — Ho Chi Minh City</span>
      </p>
    ) : (
      <a class="flex" aria-label={siteConfig.title} href="/">
        <Logo />
      </a>
    )}
    <nav class="flex items-center gap-5 lg:gap-7" aria-label="Primary">
      {navLinks.map((link) => <NavLink href={link.href}>{link.text}</NavLink>)}
    </nav>
  </div>
</header>
