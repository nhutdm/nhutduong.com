---
import type { Page } from "astro";

type Props = {
  page: Page<unknown>;
};

const { page } = Astro.props;
const hasPrev = Boolean(page.url.prev);
const hasNext = Boolean(page.url.next);
---

{(hasPrev || hasNext) && (
  <nav
    aria-label="Pagination"
    class="mono-label mt-16 flex items-center justify-between"
  >
    {hasPrev ? (
      <a
        href={page.url.prev}
        class="text-muted-foreground transition-colors hover:text-foreground"
        rel="prev"
      >
        &larr; Newer
      </a>
    ) : (
      <span class="text-muted-foreground/40" aria-disabled="true">
        &larr; Newer
      </span>
    )}
    <span class="text-muted-foreground">
      Folio {page.currentPage} of {page.lastPage}
    </span>
    {hasNext ? (
      <a
        href={page.url.next}
        class="text-muted-foreground transition-colors hover:text-foreground"
        rel="next"
      >
        Older &rarr;
      </a>
    ) : (
      <span class="text-muted-foreground/40" aria-disabled="true">
        Older &rarr;
      </span>
    )}
  </nav>
)}
