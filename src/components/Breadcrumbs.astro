---
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils";
import type { BreadcrumbItem } from "@/types";

type Props = Omit<HTMLAttributes<"nav">, "class"> & {
  items: BreadcrumbItem[];
  class?: string;
};

const { items, class: className, ...props } = Astro.props;
---

<nav aria-label="breadcrumb" class={cn(className)} {...props}>
  <ol
    class="flex flex-wrap items-center gap-2 font-mono text-xs tracking-[0.14em] uppercase text-foreground/80 tabular-nums"
  >
    {items.map((item, index) => {
      const isLast = index === items.length - 1;
      return (
        <>
          <li
            class:list={[
              isLast &&
                "max-sm:max-w-[11rem] max-sm:overflow-hidden max-sm:text-ellipsis max-sm:whitespace-nowrap",
            ]}
          >
            {item.href ? (
              <a
                href={item.href}
                class="transition-colors hover:text-foreground hover:underline hover:decoration-gold hover:underline-offset-4"
              >
                {item.label}
              </a>
            ) : (
              <span aria-current="page" class="text-foreground">
                {item.label}
              </span>
            )}
          </li>
          {index < items.length - 1 && (
            <li role="presentation" aria-hidden="true" class="text-gold-text">
              /
            </li>
          )}
        </>
      );
    })}
  </ol>
</nav>
